# =============================================================================
# Terraform
# =============================================================================
# Local .terraform directories and provider caches
**/.terraform/*

# State, plans and crash logs — never commit (state can contain secrets)
*.tfstate
*.tfstate.*
terraform.tfstate.d/
*.tfplan
tfplan
crash.log
crash.*.log

# Local overrides (used e.g. by `task bootstrap` for the first local-state run)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ad-hoc variable files stay local.
*.tfvars
*.tfvars.json
!*.tfvars.example
# Environment inputs and backend details stay local; only the placeholder is tracked.
/environments/*
.environments-config/
!/environments/.gitkeep
# Scenario templates are committed and contain placeholders, not environment values.
!examples/*/*.tfvars
!examples/*/access-contracts/*.tfvars
# Validation contract of the acceptance-test notebook (copied into an environment to run).
!validation/acceptance-contract.tfvars

# NOTE: .terraform.lock.hcl is intentionally COMMITTED for root configurations
# (HashiCorp guidance) so provider versions are reproducible. Reusable modules
# don't commit one: their caller's lock file decides the versions.
modules/**/.terraform.lock.hcl

# CLI configuration files
.terraformrc
terraform.rc

# =============================================================================
# Secrets and generated artefacts
# =============================================================================
.env
*.bak
**/sensitive-outputs.txt
modules/logic-app/.artifacts/

# =============================================================================
# Python (validation notebooks)
# =============================================================================
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
validation/results/

# =============================================================================
# Editors and OS
# =============================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local working notes (not part of the repository)
gitignore
