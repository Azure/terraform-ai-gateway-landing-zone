{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "actions": {
            "Read_Export_Config": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "databaseId": "@appsetting('CosmosDBDatabase')",
                        "containerId": "@appsetting('CosmosDBContainerConfig')",
                        "itemId": "004",
                        "partitionKey": "default"
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "AzureCosmosDB",
                        "operationId": "ReadDocument",
                        "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                    }
                },
                "runAfter": {}
            },
            "Create_Export_Config": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "databaseId": "@appsetting('CosmosDBDatabase')",
                        "containerId": "@appsetting('CosmosDBContainerConfig')",
                        "item": "{ \"id\": \"004\", \"type\": \"default\", \"lastExportDate\": \"@{formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:00')}\", \"totalExportedRecords\": 0 }",
                        "isUpsert": true
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "AzureCosmosDB",
                        "operationId": "CreateOrUpdateDocument",
                        "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                    }
                },
                "runAfter": {
                    "Read_Export_Config": [
                        "FAILED"
                    ]
                }
            },
            "Initialize_Logs_Time_Range": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "LastExportDate",
                            "type": "string",
                            "value": "@if(equals(outputs('Read_Export_Config')?['statusCode'], 'OK'), body('Read_Export_Config')?['content']['lastExportDate'], formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:00'))"
                        },
                        {
                            "name": "CurrentTime",
                            "type": "string",
                            "value": "@formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:00')"
                        }
                    ]
                },
                "runAfter": {
                    "Create_Export_Config": [
                        "SUCCEEDED",
                        "SKIPPED"
                    ]
                }
            },
            "Run_query_and_list_results": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "referenceName": "azuremonitorlogs"
                        }
                    },
                    "method": "post",
                    "body": "let startTime = todatetime('@{variables('LastExportDate')}');\nlet endTime = todatetime('@{variables('CurrentTime')}');\nlet timeInterval = 1h;\ncustomMetrics\n| extend appId = tostring(customDimensions[\"appId\"]),\n         productName = tostring(customDimensions[\"productName\"]),\n         deploymentName = tostring(customDimensions[\"deploymentName\"]),\n         backendId = tostring(customDimensions[\"backendId\"]),\n         assetType = tostring(customDimensions[\"customDimension1\"]),\n         operationName = tostring(customDimensions[\"customDimension2\"]),\n         gatewayName = tostring(customDimensions[\"Service Name\"]),\n         gatewayRegion = tostring(customDimensions[\"Region\"]),\n         timeBin = bin(timestamp, timeInterval)\n| where ingestion_time() between(startTime .. endTime) and name == 'A2ARequests'\n| summarize requestCount = sum(valueSum) by appId, deploymentName, productName, backendId, assetType, operationName, gatewayName, gatewayRegion, timeBin\n| project timestamp = format_datetime(timeBin, \"M/dd/yyyy h:mm:ss tt\"), appId, deploymentName, productName, backendId, assetType, operationName, gatewayName, gatewayRegion, requestCount",
                    "path": "/queryData",
                    "queries": {
                        "subscriptions": "@appsetting('AppInsights_SubscriptionId')",
                        "resourcegroups": "@appsetting('AppInsights_ResourceGroup')",
                        "resourcetype": "Application Insights",
                        "resourcename": "@appsetting('AppInsights_Name')",
                        "timerange": "Set in query"
                    }
                },
                "runAfter": {
                    "Initialize_Logs_Time_Range": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Parse_Metrics_Logs": {
                "type": "ParseJson",
                "inputs": {
                    "content": "@body('Run_query_and_list_results')",
                    "schema": {
                        "properties": {
                            "value": {
                                "items": {
                                    "properties": {
                                        "timestamp": { "type": "string" },
                                        "appId": { "type": "string" },
                                        "productName": { "type": "string" },
                                        "deploymentName": { "type": "string" },
                                        "backendId": { "type": "string" },
                                        "assetType": { "type": "string" },
                                        "operationName": { "type": "string" },
                                        "gatewayName": { "type": "string" },
                                        "gatewayRegion": { "type": "string" },
                                        "requestCount": { "type": "number" }
                                    },
                                    "required": [
                                        "timestamp",
                                        "appId",
                                        "deploymentName",
                                        "requestCount"
                                    ],
                                    "type": "object"
                                },
                                "type": "array"
                            }
                        },
                        "type": "object"
                    }
                },
                "runAfter": {
                    "Run_query_and_list_results": [
                        "SUCCEEDED"
                    ]
                }
            },
            "For_each": {
                "type": "Foreach",
                "foreach": "@body('Parse_Metrics_Logs')?['value']",
                "actions": {
                    "ParseMetricEntry": {
                        "type": "ParseJson",
                        "inputs": {
                            "content": "@items('For_each')",
                            "schema": {
                                "properties": {
                                    "timestamp": { "type": "string" },
                                    "appId": { "type": "string" },
                                    "productName": { "type": "string" },
                                    "deploymentName": { "type": "string" },
                                    "backendId": { "type": "string" },
                                    "assetType": { "type": "string" },
                                    "operationName": { "type": "string" },
                                    "gatewayName": { "type": "string" },
                                    "gatewayRegion": { "type": "string" },
                                    "requestCount": { "type": "number" }
                                },
                                "type": "object"
                            }
                        }
                    },
                    "Create_Usage_Log": {
                        "type": "ServiceProvider",
                        "inputs": {
                            "parameters": {
                                "databaseId": "@appsetting('CosmosDBDatabase')",
                                "containerId": "@appsetting('CosmosDBContainerAgentUsage')",
                                "item": "{\n  \"id\": \"@{concat('agent-', guid())}\",\n  \"timestamp\": \"@{body('ParseMetricEntry')?['timestamp']}\",\n  \"appId\": \"@{body('ParseMetricEntry')?['appId']}\",\n  \"productName\": \"@{body('ParseMetricEntry')?['productName']}\",\n  \"deploymentName\": \"@{body('ParseMetricEntry')?['deploymentName']}\",\n  \"backendId\": \"@{body('ParseMetricEntry')?['backendId']}\",\n  \"assetType\": \"a2a\",\n  \"operationName\": \"@{body('ParseMetricEntry')?['operationName']}\",\n  \"gatewayName\": \"@{body('ParseMetricEntry')?['gatewayName']}\",\n  \"gatewayRegion\": \"@{body('ParseMetricEntry')?['gatewayRegion']}\",\n  \"requestCount\": @{body('ParseMetricEntry')?['requestCount']},\n  \"targetService\": \"A2A\",\n  \"aiGatewayId\": \"managed\"\n}",
                                "isUpsert": true
                            },
                            "serviceProviderConfiguration": {
                                "connectionName": "AzureCosmosDB",
                                "operationId": "CreateOrUpdateDocument",
                                "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                            }
                        },
                        "runAfter": {
                            "ParseMetricEntry": [
                                "SUCCEEDED"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Parse_Metrics_Logs": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Update_Export_Config": {
                "type": "ServiceProvider",
                "inputs": {
                    "parameters": {
                        "databaseId": "@appsetting('CosmosDBDatabase')",
                        "containerId": "@appsetting('CosmosDBContainerConfig')",
                        "item": "{ \"id\": \"004\", \"type\": \"default\", \"lastExportDate\": \"@{variables('CurrentTime')}\", \"totalExportedRecords\": @{length(body('Run_query_and_list_results')?['value'])} }",
                        "isUpsert": true
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "AzureCosmosDB",
                        "operationId": "CreateOrUpdateDocument",
                        "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                    }
                },
                "runAfter": {
                    "For_each": [
                        "SUCCEEDED"
                    ]
                }
            }
        },
        "contentVersion": "1.0.0.0",
        "outputs": {},
        "triggers": {
            "Recurrence": {
                "type": "Recurrence",
                "recurrence": {
                    "frequency": "Day",
                    "interval": 1,
                    "schedule": {
                        "hours": [
                            "3",
                            "6",
                            "9",
                            "12",
                            "15",
                            "18",
                            "21",
                            "23"
                        ]
                    },
                    "timeZone": "GMT Standard Time"
                }
            }
        }
    },
    "kind": "Stateful"
}
