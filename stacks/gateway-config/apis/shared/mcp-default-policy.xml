<policies>
	<inbound>
		<base />
		<!-- Usage metric for the usage pipeline (McpRequests -> mcp-usage-ingestion -> mcp-usage-container).
		     Inbound only: MCP responses stream (SSE), and reading the response would buffer them. -->
		<include-fragment fragment-id="mcp-usage" />
		<!-- <trace source="Default MCP" severity="information">
			<message>Default MCP trace info</message>
			<metadata name="agent-id" value="@(context.Request.Headers.GetValueOrDefault("application", "n/a"))" />
		</trace> -->
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
		<!-- usage event of an error: contracts with usage_events, and missing / invalid keys with
		     gateway-config usage_events.record_key_rejections (no-op otherwise; once per request) -->
		<include-fragment fragment-id="usage-event" />
	</on-error>
</policies>
