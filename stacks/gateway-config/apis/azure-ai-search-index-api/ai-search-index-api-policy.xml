<policies>
    <inbound>
        <base />
        
        <authentication-managed-identity resource="https://search.azure.com" output-token-variable-name="msi-access-token" client-id="{{uami-client-id}}" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <!-- usage event of an error: contracts with usage_events, and missing / invalid keys with
             gateway-config usage_events.record_key_rejections (no-op otherwise; once per request) -->
        <include-fragment fragment-id="usage-event" />
    </on-error>
</policies>