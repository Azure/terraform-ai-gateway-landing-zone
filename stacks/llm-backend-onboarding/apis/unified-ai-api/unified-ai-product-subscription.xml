<policies>
    <inbound>
        <base />
        <set-variable name="enableResponseHeaders" value="@(true)" />
        <!-- Product access validation - ensure access is through valid product -->
        <choose>
            <when condition="@(context.Product == null)">
                <!-- usage event of a request the gateway answers itself (usage-event fragment) -->
                <set-variable name="usageEventStatus" value="401" />
                <set-variable name="usageEventReason" value="unified-ai-product-subscription" />
                <include-fragment fragment-id="usage-event" />
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>@{
                        return new JObject(
                            new JProperty("error", new JObject(
                                new JProperty("message", "Access denied. API requests must be made through a product subscription."),
                                new JProperty("code", "product_required")
                            ))
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
