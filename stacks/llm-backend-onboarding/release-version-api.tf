# Release Version API: the release of this deployment (GET /version) and the live LLM
# backend routing contract (GET /version/backend-contract). The contract lists backend
# endpoints and the names of their key named values, so a subscription key is required.

locals {
  # version.txt is written by release-please; a checkout without a release has none.
  release_version = fileexists("${path.module}/../../version.txt") ? trimspace(file("${path.module}/../../version.txt")) : "0.0.0"

  release_version_policy_xml = <<-XML
    <policies>
        <inbound>
            <base />
            <return-response>
                <set-status code="200" reason="OK" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-body>${jsonencode({ "master-version" = local.release_version, "backend-contract-version" = module.llm_routing.backend_contract_version })}</set-body>
            </return-response>
        </inbound>
        <backend>
            <base />
        </backend>
        <outbound>
            <base />
        </outbound>
        <on-error>
            <base />
        </on-error>
    </policies>
  XML

  # The operation includes the backend-contract fragment generated by modules/llm-routing.
  backend_contract_policy_xml = <<-XML
    <policies>
        <inbound>
            <base />
            <include-fragment fragment-id="backend-contract" />
        </inbound>
        <backend>
            <base />
        </backend>
        <outbound>
            <base />
        </outbound>
        <on-error>
            <base />
        </on-error>
    </policies>
  XML
}

module "release_version_api" {
  source = "../../modules/gateway-api"

  api_management_id   = local.apim_id
  api_management_name = local.apim_name
  resource_group_name = local.resource_group_name

  api = {
    name                   = "release-version-api"
    display_name           = "Release Version API"
    description            = "Release version of the AI Hub Gateway and the live LLM backend routing contract."
    path                   = "version"
    subscription_required  = true
    subscription_key_names = local.api_key_names
    service_url            = "https://to-be-replaced-by-policy"
    spec                   = { format = "openapi+json", value = file("${local.apis_dir}/release-version-api/openapi.json") }
  }

  azapi_operation_policies = {
    "get-version"          = local.release_version_policy_xml
    "get-backend-contract" = local.backend_contract_policy_xml
  }

  # APIM validates fragment references when a policy is saved.
  policy_depends_on = local.api_policy_depends_on
}
