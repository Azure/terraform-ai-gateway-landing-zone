# =============================================================================
# AI Citadel Governance Hub - Development Environment
# T-Shirt Size: Small (Developer SKU, minimal capacity, public access)
# -----------------------------------------------------------------------------
# This file contains placeholders for EVERY root variable (see VARIABLES.md).
# Uncomment and edit entries to override defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASIC CONFIGURATION
# -----------------------------------------------------------------------------
environment_name             = "dev-01"
location                     = "swedencentral"
subscription_id              = ""   # replace before deploying
purge_soft_delete_on_destroy = true # dev convenience; not for prod

tags = {
  Environment     = "Development"
  CostCenter      = "Engineering"
  Owner           = "platform-team@contoso.com"
  Criticality     = "Low"
  ManagedBy       = "Terraform"
  SecurityControl = "Ignore"
}

# -----------------------------------------------------------------------------
# 2. RESOURCE NAMING (blank = auto-generated)
# -----------------------------------------------------------------------------
resource_group_name         = "rg-citadel-dev-01"
use_existing_resource_group = false
# APIM name: set apim.name (section 5) to override the generated name
# cosmos_db_account_name    = ""
# eventhub_namespace_name   = ""
# log_analytics_name        = ""
# key_vault_name            = ""

# -----------------------------------------------------------------------------
# 3. SECURITY / KEY VAULT
# -----------------------------------------------------------------------------
purge_protection_enabled         = false # dev convenience
rbac_authorization_enabled       = true
soft_delete_retention_days       = 7
network_acl_default_action       = "Allow" # relaxed for dev
kv_public_network_access_enabled = true    # relaxed for dev
key_vault_sku                    = "standard"
kv_deployer_ip_rules             = []
kv_auto_detect_deployer_ip       = true # convenient for local dev; not recommended for CI with unstable egress IPs

# -----------------------------------------------------------------------------
# 4. NETWORKING (typed input `network`, see interfaces.tf; greenfield = new VNet)
# -----------------------------------------------------------------------------
network = {
  mode          = "greenfield"
  address_space = "10.170.0.0/24"
  subnets = {
    apim             = { name = "snet-citadel-apim", prefix = "10.170.0.0/26" }
    private_endpoint = { name = "snet-citadel-pe", prefix = "10.170.0.64/26" }
    logic_app        = { name = "snet-citadel-functions", prefix = "10.170.0.128/26" }
    agent            = { enabled = true, name = "snet-agents", prefix = "10.170.0.192/26" }
  }
  # Existing VNet: mode = "byo", resource_group_name = "...", vnet_name = "..."
  # Existing private DNS zones: private_dns = { resource_group_name = "...", zone_ids = { ... } }
}

# -----------------------------------------------------------------------------
# 5. COMPUTE SKU & SIZING (typed inputs `apim` and `usage_pipeline`)
# -----------------------------------------------------------------------------
apim = {
  sku                   = "Developer"
  capacity              = 1
  vnet_mode             = "external" # Developer/Premium: none | external | internal
  publisher_email       = "admin@contoso.com"
  publisher_name        = "AI Citadel Admin"
  private_endpoint      = true # v2 SKUs only
  public_network_access = true # v2 SKUs only
}

usage_pipeline = {
  eventhub = {
    capacity              = 1
    public_network_access = "Enabled"
    disaster_recovery     = null # { partner_namespace_id, alias }
  }
  cosmos = {
    public_network_access = "Enabled"
  }
  logic_app = {
    hosting            = "workflow_standard" # or ase_v3 (keyless storage; see asetest.tfvars.example)
    sku                = "WS1"
    content_share_name = "" # auto-derived if blank
    code_deploy        = true
    code_source_path   = "logicapp-src/usage-ingestion-logicapp" # blank → use vendored accelerator project
  }
}

api_center_sku = "Free"

# -----------------------------------------------------------------------------
# 6. FEATURE FLAGS (typed input `features`)
# -----------------------------------------------------------------------------
features = {
  api_center            = true
  api_center_onboarding = true
  pii_redaction         = true
  pii_anonymization     = true
  content_safety        = true
  semantic_cache        = false # deploys Azure Managed Redis
  embeddings_backend    = false
  ai_model_inference    = true
  document_intelligence = true
  azure_ai_search       = false
  openai_realtime       = true
  unified_ai_api        = true
  mcp_sample            = true
}

# -----------------------------------------------------------------------------
# 7. LOG ANALYTICS / MONITORING (typed input `monitoring`)
# -----------------------------------------------------------------------------
monitoring = {
  private_link_scope      = false
  app_insights_dashboards = true
  # log_analytics_workspace_id    = "" # BYO workspace
  # log_analytics_subscription_id = ""
}

# -----------------------------------------------------------------------------
# 8. NETWORK ACCESS (relaxed for dev)
# -----------------------------------------------------------------------------
ai_foundry_external_access = true

# -----------------------------------------------------------------------------
# 9. ENTRA ID AUTHENTICATION (API key only for dev)
# -----------------------------------------------------------------------------
entra_auth_enabled = false
# entra_tenant_id   = ""
# entra_client_id   = ""
# entra_audience    = ""

# -----------------------------------------------------------------------------
# 10. AI FOUNDRY
# -----------------------------------------------------------------------------
foundry_network_injection_enabled = true
ai_foundry_instances = [
  {
    location                  = "swedencentral"
    default_project_name      = "citadel-dev-project"
    network_injection_enabled = true
  }
]

ai_foundry_models = [
  {
    name             = "gpt-4.1"
    version          = "2025-04-14"
    sku              = "GlobalStandard"
    capacity         = 50
    publisher        = "OpenAI"
    ai_service_index = 0
  },
  {
    name             = "gpt-4.1-mini"
    version          = "2025-04-14"
    sku              = "GlobalStandard"
    capacity         = 50
    publisher        = "OpenAI"
    ai_service_index = 0
  }
]

# -----------------------------------------------------------------------------
# 11. LLM BACKEND ROUTING
# -----------------------------------------------------------------------------
# Auto-derived from `enable_ai_foundry` + `ai_foundry_instances` + `ai_foundry_models`.
llm_backend_config = []
extra_llm_backends = []

# -----------------------------------------------------------------------------
# 12. DIAGNOSTIC LOGGING
# -----------------------------------------------------------------------------
apim_log_verbosity  = "verbose"
apim_log_body_bytes = 8192

# -----------------------------------------------------------------------------
# 13. REDIS (Azure Managed Redis) — only used if features.semantic_cache = true
# -----------------------------------------------------------------------------
redis_sku_name              = "Balanced_B10"
redis_sku_capacity          = 2
redis_public_network_access = "Disabled"
redis_minimum_tls_version   = "1.2"

# -----------------------------------------------------------------------------
# 14. OPTIONAL APIM EXTRA APIs (off by default in dev)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 15. API CENTER
# -----------------------------------------------------------------------------
apic_location = "westeurope"

# -----------------------------------------------------------------------------
# 16. AI SEARCH INSTANCES (existing endpoints to register)
# -----------------------------------------------------------------------------
ai_search_instances = []
# ai_search_instances = [
#   { name = "dev-search", endpoint = "https://my-search.search.windows.net" }
# ]

# -----------------------------------------------------------------------------
# 17. AZURE MONITOR PRIVATE LINK
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 18. FOUNDRY EMBEDDINGS (semantic cache)
# -----------------------------------------------------------------------------
embeddings_backend_url = ""

# -----------------------------------------------------------------------------
# 19. LOGIC APP CONTENT SHARE
# -----------------------------------------------------------------------------

# Workflow-code publish (zip + `az functionapp deployment source config-zip`
# of src/usage-ingestion-logicapp). See DEPLOYMENT_GUIDE.md §7.8.

# -----------------------------------------------------------------------------
# 20. APIM LOGIC PLANE (JWT / PII / MCP)
# -----------------------------------------------------------------------------
configure_circuit_breaker = true
ms_learn_mcp_backend_url  = "https://learn.microsoft.com/api/mcp"
enable_jwt_auth           = false
jwt_tenant_id             = ""
jwt_app_registration_id   = ""
azure_login_endpoint      = "https://login.microsoftonline.com/"

# -----------------------------------------------------------------------------
# 21. ENTRA ID ADD-ON (app registration)
# -----------------------------------------------------------------------------
enable_entra_id_setup             = false
entra_app_display_name_prefix     = "ai-citadel-gateway"
entra_client_secret_name          = "ENTRA-APP-CLIENT-SECRET"
entra_client_secret_rotation_days = 730

# -----------------------------------------------------------------------------
# 22. FOUNDRY → APIM CONNECTION
# -----------------------------------------------------------------------------
enable_foundry_apim_connection = true
