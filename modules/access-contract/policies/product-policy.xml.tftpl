<policies>
    <inbound>
        <base />
%{ if jwt_required }
        <!-- Validate the token the Foundry project's managed identity sends next to the api-key (read by the security-handler fragment) -->
        <set-variable name="jwtRequired" value="true" />
        <set-variable name="jwtAudience" value="${jwt_audience}" />
        <set-variable name="jwtIssuer" value="https://sts.windows.net/${tenant_id}/" />
        <set-variable name="jwtOpenIdConfigUrl" value="https://login.microsoftonline.com/${tenant_id}/v2.0/.well-known/openid-configuration" />
%{ endif }
        <!-- Extract and validate model parameter from request -->
        <include-fragment fragment-id="set-llm-requested-model" />
%{ if allowed_models != "" }
        <!-- Model-level RBAC: only these models (and aliases) are allowed for this contract -->
        <set-variable name="allowedModels" value="${allowed_models}" />
        <include-fragment fragment-id="validate-model-access" />
%{ endif }
%{ if token_limit_attributes != "" }
        <!-- Capacity management - subscription level -->
        <llm-token-limit counter-key="@(context.Subscription.Id)" ${token_limit_attributes} estimate-prompt-tokens="false" />
%{ endif }
%{ if enable_response_headers }
        <!-- Enable advanced response headers offered by set-response-headers fragment -->
        <set-variable name="enableResponseHeaders" value="@(true)" />
%{ endif }
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <!-- Raising throttling events (http 429 only) can help in setting up alerts in App Insights -->
        <!-- Set the following variables to customize the throttling event details -->
        <!-- <set-variable name="productName" value="@(context.Product?.Name?.ToString() ?? "Portal-Admin")" />
        <set-variable name="deploymentName" value="@((string)context.Variables.GetValueOrDefault<string>("requestedModel", "DefaultModel"))" />
        <set-variable name="appId" value="@((string)context.Variables.GetValueOrDefault<string>("appId", context.Subscription?.Id ?? "Portal-Admin-Sub"))" />
        <include-fragment fragment-id="raise-throttling-events" /> -->
    </on-error>
</policies>
